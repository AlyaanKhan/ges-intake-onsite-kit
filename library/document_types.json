{
  "note": "Rule-based document fingerprints. Phrases are matched against normalized text (see TASK.md section 5.3). Field patterns are Python regular expressions compiled with re.MULTILINE | re.IGNORECASE.",
  "document_types": [
    {
      "id": "DT-ENGAGEMENT-LETTER",
      "cel": "CEL-GOV-001",
      "match": {
        "all": [
          "engagement letter",
          "peach state advisory"
        ],
        "none": []
      },
      "provenance": {
        "default": "P3"
      },
      "fields": {
        "client_name": {
          "pattern": "^Client Name:\\s*(.+)$",
          "type": "text"
        },
        "signature": {
          "pattern": "^Client Signature:[ \\t]*(\\S.*)$",
          "type": "text"
        },
        "signed_date": {
          "pattern": "^Date Signed:\\s*(.+)$",
          "type": "date"
        }
      },
      "required_fields": [
        "client_name",
        "signature",
        "signed_date"
      ],
      "identity": {
        "name_field": "client_name"
      }
    },
    {
      "id": "DT-DRIVERS-LICENSE",
      "cel": "CEL-GOV-002",
      "match": {
        "all": [
          "driver license",
          "department of driver services"
        ],
        "none": []
      },
      "provenance": {
        "default": "P1"
      },
      "fields": {
        "full_name": {
          "pattern": "^Name:\\s*(.+)$",
          "type": "text"
        },
        "license_no": {
          "pattern": "^License No:\\s*(.+)$",
          "type": "account"
        },
        "expiration": {
          "pattern": "^Expires:\\s*(.+)$",
          "type": "date"
        }
      },
      "required_fields": [
        "full_name",
        "expiration"
      ],
      "identity": {
        "name_field": "full_name"
      }
    },
    {
      "id": "DT-PASSPORT",
      "cel": "CEL-GOV-002",
      "match": {
        "all": [
          "passport",
          "united states of america",
          "department of state"
        ],
        "none": []
      },
      "provenance": {
        "default": "P1"
      },
      "fields": {
        "full_name": {
          "pattern": "^Name:\\s*(.+)$",
          "type": "text"
        },
        "passport_no": {
          "pattern": "^Passport No:\\s*(.+)$",
          "type": "account"
        },
        "expiration": {
          "pattern": "^Date of Expiration:\\s*(.+)$",
          "type": "date"
        }
      },
      "required_fields": [
        "full_name",
        "expiration"
      ],
      "identity": {
        "name_field": "full_name"
      }
    },
    {
      "id": "DT-IRS-TRANSCRIPT",
      "cel": "CEL-TAX-001",
      "match": {
        "all": [
          "tax return transcript",
          "internal revenue service"
        ],
        "none": []
      },
      "provenance": {
        "default": "P3",
        "by_channel": {
          "irs_transcript_feed": "P1"
        },
        "claims_official": true
      },
      "fields": {
        "taxpayer_name": {
          "pattern": "^Taxpayer Name:\\s*(.+)$",
          "type": "text"
        },
        "ssn": {
          "pattern": "^SSN Provided:\\s*(\\S+)\\s*$",
          "type": "ssn"
        },
        "tax_year": {
          "pattern": "^Tax Year:\\s*(\\d{4})\\s*$",
          "type": "year"
        }
      },
      "required_fields": [
        "ssn",
        "tax_year"
      ],
      "identity": {
        "ssn_field": "ssn",
        "name_field": "taxpayer_name"
      }
    },
    {
      "id": "DT-1040",
      "cel": "CEL-TAX-001",
      "match": {
        "all": [
          "form 1040",
          "u.s. individual income tax return"
        ],
        "none": [
          "tax return transcript"
        ]
      },
      "provenance": {
        "default": "P3"
      },
      "fields": {
        "taxpayer_name": {
          "pattern": "^Your first name and last name:\\s*(.+)$",
          "type": "text"
        },
        "ssn": {
          "pattern": "^Your social security number:\\s*(\\S+)\\s*$",
          "type": "ssn"
        },
        "tax_year": {
          "pattern": "^Tax Year:\\s*(\\d{4})\\s*$",
          "type": "year"
        }
      },
      "required_fields": [
        "ssn",
        "tax_year"
      ],
      "identity": {
        "ssn_field": "ssn",
        "name_field": "taxpayer_name"
      }
    },
    {
      "id": "DT-W2",
      "cel": "CEL-INC-001",
      "match": {
        "all": [
          "form w-2",
          "wage and tax statement"
        ],
        "none": [
          "form w-2c",
          "corrected wage"
        ]
      },
      "provenance": {
        "default": "P2"
      },
      "fields": {
        "employee_name": {
          "pattern": "^Employee's name:\\s*(.+)$",
          "type": "text"
        },
        "employee_ssn": {
          "pattern": "^Employee's SSN:\\s*(\\S+)\\s*$",
          "type": "ssn"
        },
        "employer_ein": {
          "pattern": "^Employer EIN:\\s*(\\S+)\\s*$",
          "type": "ein"
        },
        "tax_year": {
          "pattern": "^Tax Year:\\s*(\\d{4})\\s*$",
          "type": "year"
        },
        "wages": {
          "pattern": "^Box 1 Wages, tips, other compensation:\\s*(.+)$",
          "type": "money"
        }
      },
      "required_fields": [
        "employee_ssn",
        "employer_ein",
        "tax_year",
        "wages"
      ],
      "identity": {
        "ssn_field": "employee_ssn",
        "name_field": "employee_name"
      },
      "supersede": {
        "key": [
          "employer_ein",
          "tax_year"
        ],
        "supersedes": [
          "DT-W2"
        ]
      }
    },
    {
      "id": "DT-W2C",
      "cel": "CEL-INC-001",
      "match": {
        "all": [
          "form w-2c",
          "corrected wage and tax statement"
        ],
        "none": []
      },
      "provenance": {
        "default": "P2"
      },
      "fields": {
        "employee_name": {
          "pattern": "^Employee's name:\\s*(.+)$",
          "type": "text"
        },
        "employee_ssn": {
          "pattern": "^Employee's SSN:\\s*(\\S+)\\s*$",
          "type": "ssn"
        },
        "employer_ein": {
          "pattern": "^Employer EIN:\\s*(\\S+)\\s*$",
          "type": "ein"
        },
        "tax_year": {
          "pattern": "^Tax Year:\\s*(\\d{4})\\s*$",
          "type": "year"
        },
        "wages": {
          "pattern": "^Box 1 Wages, tips, other compensation \\(corrected\\):\\s*(.+)$",
          "type": "money"
        }
      },
      "required_fields": [
        "employee_ssn",
        "employer_ein",
        "tax_year",
        "wages"
      ],
      "identity": {
        "ssn_field": "employee_ssn",
        "name_field": "employee_name"
      },
      "supersede": {
        "key": [
          "employer_ein",
          "tax_year"
        ],
        "supersedes": [
          "DT-W2",
          "DT-W2C"
        ]
      }
    },
    {
