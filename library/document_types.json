    {
      "id": "DT-BANK-STATEMENT",
      "cel": "CEL-BNK-001",
      "match": {
        "all": [
          "statement period",
          "beginning balance",
          "ending balance"
        ],
        "none": []
      },
      "provenance": {
        "default": "P2"
      },
      "fields": {
        "account_holder": {
          "pattern": "^Account Holder:\\s*(.+)$",
          "type": "text"
        },
        "account": {
          "pattern": "^Account Number:\\s*([0-9][0-9 \\-]*[0-9])\\s*$",
          "type": "account"
        },
        "period": {
          "pattern": "^Statement Period:\\s*(.+?)\\s+(?:-|to|through)\\s+(.+?)\\s*$",
          "type": "date_range"
        },
        "beginning_balance": {
          "pattern": "^Beginning Balance:\\s*(.+)$",
          "type": "money"
        },
        "ending_balance": {
          "pattern": "^Ending Balance:\\s*(.+)$",
          "type": "money"
        }
      },
      "required_fields": [
        "account",
        "period",
        "beginning_balance",
        "ending_balance"
      ],
      "identity": {
        "name_field": "account_holder",
        "account_field": "account"
      },
      "supersede": {
        "key": [
          "account",
          "period_start"
        ],
        "supersedes": [
          "DT-BANK-STATEMENT"
        ]
      }
    },
    {
      "id": "DT-GL-EXPORT",
