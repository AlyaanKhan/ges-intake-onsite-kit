          "pattern": "^Prepared for:\\s*(.+)$",
          "type": "text"
        },
        "period": {
          "pattern": "^Period:\\s*(.+?)\\s+(?:-|to|through)\\s+(.+?)\\s*$",
          "type": "date_range"
        }
      },
      "required_fields": [
        "period"
      ],
      "identity": {
        "name_field": "prepared_for"
      },
      "supersede": {
        "key": [
          "period_start"
        ],
        "supersedes": [
          "DT-GL-EXPORT"
        ]
      }
    }
  ]
